# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# anon key: Supabase Dashboard → Settings → API → anon/public
# Requerida — supabaseClient.js tira el server abajo al bootear si falta
SUPABASE_ANON_KEY=
# service_role key: Supabase Dashboard → Settings → API → service_role
# NUNCA en el frontend ni en repos públicos
SUPABASE_SERVICE_ROLE_KEY=

# ── MercadoPago ───────────────────────────────────────────────────────────────
# Producción: MP Dashboard → Credenciales → Access token (APP_USR-...)
# Sandbox:    MP Dashboard → Credenciales → Access token de prueba (TEST-...)
MP_ACCESS_TOKEN=

# Panel de MP → Tu negocio → Webhooks → Clave secreta de la notificación
MP_WEBHOOK_SECRET=

# ── Getnet (⚠️ WIP — ver docs/GETNET-INTEGRACION.md) ─────────────────────────
# No es la pasarela en uso — MercadoPago sigue siendo la real. Sin
# GETNET_CLIENT_ID/GETNET_CLIENT_SECRET, getnetController.js devuelve 501
# siempre (no rompe nada dejarlas vacías). Completar solo una vez que exista
# cuenta comercial real (developer.globalgetnet.com).
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
# Identificador del comercio, va en el header x-seller-id de cada request.
GETNET_SELLER_ID=
# Secreto para verificar la firma del webhook (ver getnetUtils.js — fórmula
# exacta sin confirmar contra la API real todavía).
GETNET_WEBHOOK_SECRET=
# 'sandbox' (default) | 'production' — define qué base URL usa getnetClient.js
GETNET_ENV=sandbox
# Opcional — override manual de la base URL si developer.globalgetnet.com
# confirma un host distinto al asumido en getnetClient.js
GETNET_API_BASE=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:tu@email.com

# ── URLs públicas (sin barra final) ──────────────────────────────────────────
# Desarrollo local:
#   FRONTEND_URL=http://localhost:8000
#   SERVER_URL=http://localhost:3000  (o URL de ngrok si necesitás webhooks)
FRONTEND_URL=https://tudominio.vercel.app
SERVER_URL=https://api.tudominio.com

# ── Puerto ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Concurrencia (opcional) ──────────────────────────────────────────────────
# Cantidad de workers HTTP (node:cluster) dentro de esta misma instancia.
# Vacío o 1 = sin clustering, comportamiento de siempre. Ver CLAUDE.md §16
# antes de subir esto en Railway (elegir según los vCPU reales del servicio,
# no adivinar).
WEB_CONCURRENCY=1
